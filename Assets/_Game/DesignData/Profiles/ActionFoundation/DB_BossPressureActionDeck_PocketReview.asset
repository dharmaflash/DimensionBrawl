  m_Script: {fileID: 11500000, guid: 7a80e6e9179c47d3a80512a3e5cfe5a4, type: 3}
  m_Name: DB_BossPressureActionDeck_PocketReview
  m_EditorClassIdentifier: DimensionBrawl.Runtime::DimensionBrawl.Combat.BossPressureActionDeckProfile
  deckId: PocketReviewBoss
  globalRecoverySeconds: 0.35
  actionSlots:
  - Pattern: {fileID: 11400000, guid: 25cd6927b39e10048ab562c4e150cb3a, type: 2}
    ActionKind: 0
    MinimumTier: 1
    QueuedWaves: 1
    MinimumIntervalSeconds: 4.2
    ResponseId: DodgeLineOrUseSkill1
    StageLoopRole: LV1 skill pressure that asks the player to read a committed rail before spending summon resources.
    PlayerAnswer: Strafe or dodge out of the rail, then use ranged fire or Skill1 when the lane is clear.
    SummonAnswer: No summon is required; save SummonSlot1 for screen pressure.
    UsePlayerForwardRiskGate: 0
    MinimumPlayerForwardRisk01: 0
    MaximumPlayerForwardRisk01: 1
  - Pattern: {fileID: 11400000, guid: 732ffa1eae726f14386a4a02115611c9, type: 2}
    ActionKind: 1
    MinimumTier: 1
    QueuedWaves: 1
    MinimumIntervalSeconds: 3.8
    ResponseId: EscortProbeFrontlineCheck
    StageLoopRole: LV1 escort-probe summon pressure that lets the boss contest the frontline before the player reaches a full support stack.
    PlayerAnswer: Use ranged fire or a cheap summon answer before the probe turns the lane into a screen trade.
    SummonAnswer: A low-tier summon can body-clash or absorb the probe without waiting for a perfect LV2 answer.
    UsePlayerForwardRiskGate: 0
    MinimumPlayerForwardRisk01: 0
    MaximumPlayerForwardRisk01: 1
  - Pattern: {fileID: 11400000, guid: 732ffa1eae726f14386a4a02115611c9, type: 2}
    ActionKind: 1
    MinimumTier: 2
    QueuedWaves: 1
    MinimumIntervalSeconds: 4.2
    ResponseId: SummonSlot1PressureBlock
    StageLoopRole: LV2 summon-pressure exchange that tests whether the player can answer boss fire with a frontline summon screen.
    PlayerAnswer: Hold forward-risk only long enough to charge EN, then create space for the summon block.
    SummonAnswer: Spend SummonSlot1 to place a pressure screen and intercept the boss curtain.
    UsePlayerForwardRiskGate: 1
    MinimumPlayerForwardRisk01: 0.22
    MaximumPlayerForwardRisk01: 1
  - Pattern: {fileID: 11400000, guid: b0b5e71e44209f74394f56e232db8d78, type: 2}
    ActionKind: 2
    MinimumTier: 3
    QueuedWaves: 1
    MinimumIntervalSeconds: 6
    ResponseId: RetreatOrSpendHighTierAnswer
    StageLoopRole: LV3 overextend punish that closes gaps when the player stays near the forward boundary too long.
    PlayerAnswer: Retreat from forward-risk space or dodge through the shrinking net before firing back.
    SummonAnswer: A prepared high-tier summon screen can buy the follow-up window, but it should cost the player's stored EN.
    UsePlayerForwardRiskGate: 1
    MinimumPlayerForwardRisk01: 0.66
    MaximumPlayerForwardRisk01: 1
