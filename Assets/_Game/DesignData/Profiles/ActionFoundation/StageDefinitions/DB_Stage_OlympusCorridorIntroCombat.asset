%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cd83a106a8ee78e45919f10ddb386e62, type: 3}
  m_Name: DB_Stage_OlympusCorridorIntroCombat
  m_EditorClassIdentifier: DimensionBrawl.Runtime::DimensionBrawl.LevelDesign.StageDefinitionProfile
  stageId: OLYMPUS-CORRIDOR-INTRO-COMBAT-01
  displayName: Olympus Corridor Intro Tutorial
  chapterId: OLYMPUS-INVASION
  previousStageId: 
  nextStageId: 
  mapScenePath: Assets/_Game/Scenes/OlympusCorridorInvasionStage.unity
  mapRootName: OlympusCorridorStageRoot
  mapContentRootName: OlympusCorridorStageMap
  mapScale: {x: 1.5, y: 1.5, z: 1.5}
  layoutId: OLYMPUS_CORRIDOR_LONG_01
  scenePrefabSource: 
  objective: Intro presentation and the ordered melee, movement, ranged, dodge, and
    target-clear tutorial run in this physical Corridor segment.
  clearCondition: The tutorial facts seal, the stair route opens, and the player
    reaches the lower Station-entry boundary in the same scene.
  excludedScope: Station guide, boss terminal authority, result UI, enemy balance,
    reward payout, and persistent progress remain separately owned.
  anchors:
  - anchorId: Player_LeftShoulderCameraAnchor
    groupId: CombatSpawnAnchors
    expectedPosition: {x: -51.402077, y: 9.785, z: -0.4110782}
    expectedEuler: {x: 0, y: 90, z: 0}
    purpose: Player camera and start read for the intro-to-tutorial handoff.
  - anchorId: IntroCutscene_End_PlayerHandoffAnchor
    groupId: CutsceneHandoffAnchors
    expectedPosition: {x: -51.402077, y: 9.785, z: -0.4110782}
    expectedEuler: {x: 0, y: 90, z: 0}
    purpose: Intro presentation exits into the Corridor tutorial view.
  - anchorId: Gameplay_CombatStartAnchor
    groupId: CutsceneHandoffAnchors
    expectedPosition: {x: -51.402077, y: 7.9849997, z: -0.4110782}
    expectedEuler: {x: 0, y: 90, z: 0}
    purpose: Corridor tutorial camera and input unlock handoff.
  - anchorId: StageSpawner_PlayerStart
    groupId: RuntimeStateAnchors
    expectedPosition: {x: -51.402077, y: 7.9849997, z: -0.4110782}
    expectedEuler: {x: 0, y: 90, z: 0}
    purpose: Runtime position for the Corridor tutorial player start.
  spawns:
  - spawnId: player-start
    spawnKind: 0
    positionId: 1001
    anchorId: StageSpawner_PlayerStart
    payloadId: PlayerParty
    count: 1
    delaySeconds: 0
    note: Player spawn is a physical segment position, not a balance value.
  cutsceneHandoffs:
  - handoffId: intro-to-stage
    anchorId: IntroCutscene_End_PlayerHandoffAnchor
    cinematicProfileId: DB_Cinematic_IntroGatePodAwakening_OlympusBombingPrelude
    timelineAssetPath: Assets/_Game/DesignData/Timelines/Cinematics/DB_Timeline_IntroGatePodAwakening_OlympusBombingPrelude.playable
    nextEventId: corridor.tutorial.ready
    purpose: The combined intro presentation hands control to the Corridor tutorial.
  runtimeStates:
  - stateId: position-player-start
    stateKind: 0
    positionId: 1001
    anchorId: StageSpawner_PlayerStart
    conditionId: run.entry.admitted
    note: Corridor tutorial player entry position.
  - stateId: state-intro-handoff
    stateKind: 1
    positionId: 4001
    anchorId: IntroCutscene_End_PlayerHandoffAnchor
    conditionId: corridor.tutorial.ready
    note: Intro completion unlocks the tutorial segment; it does not imply Station
      clear.
  sourceReferences:
  - sourceId: local-olympus-corridor
    sourcePath: Assets/_Game/Scenes/OlympusCorridorInvasionStage.unity
    localTakeaway: This definition owns only the physical Corridor intro and tutorial
      segment.
