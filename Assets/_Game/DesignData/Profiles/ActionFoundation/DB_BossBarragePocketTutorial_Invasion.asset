  m_Script: {fileID: 11500000, guid: f2d7e58f012c4a2e8f91b6b3b0a5c4d1, type: 3}
  m_Name: DB_BossBarragePocketTutorial_Invasion
  m_EditorClassIdentifier: Assembly-CSharp::DimensionBrawl.UI.BossBarrageLaneReviewTutorialProfile
  tutorialEnabled: 1
  clearObjective: '압박 차단 완료: S1이 막고 Skill1이 확인했다.'
  failObjective: '실패: HP가 먼저 무너졌거나 소환 답이 늦었다.'
  steps:
  - stepId: dodge_barrage
    objectiveText: '보스 경고선을 먼저 읽어라.'
    promptText: '경고선은 막지 말고 피한다. 기본 사격은 보스 해답이 아니다.'
    focusAction: 110
    dimUnfocusedActions: 1
    completionCondition: 10
    requiredTier: 1
    requiredMana: 0
    minimumSeconds: 0.25
  - stepId: forward_en
    objectiveText: '전방 위험선에서 EN을 충전해라.'
    promptText: '앞쪽일수록 EN이 빨리 찬다. 경계선 너머는 소환수가 맡는다.'
    focusAction: 10
    dimUnfocusedActions: 1
    completionCondition: 30
    requiredTier: 1
    requiredMana: 0
    minimumSeconds: 0.25
  - stepId: slot_read
    objectiveText: 'EN LV와 S1/S2/S3 역할을 확인해라.'
    promptText: 'S1은 차단, S2는 원거리 지원, S3는 고비용 돌파. 세 슬롯을 따로 읽어.'
    focusAction: 200
    dimUnfocusedActions: 1
    completionCondition: 40
    requiredTier: 2
    requiredMana: 200
    minimumSeconds: 0.35
  - stepId: close_probe
    objectiveText: '붙은 적은 근접 방어로 끊어라.'
    promptText: '가까운 압박만 직접 처리하고, 보스 압박용 EN은 남겨라.'
    focusAction: 100
    dimUnfocusedActions: 1
    completionCondition: 51
    requiredTier: 1
    requiredMana: 0
    minimumSeconds: 0.35
  - stepId: s1_block
    objectiveText: '보스 압박이 열리면 S1을 투입해라.'
    promptText: 'S1은 첫 차단 역할이다. 전선 너머는 직접 건너지 않는다.'
    focusAction: 200
    dimUnfocusedActions: 1
    completionCondition: 60
    requiredTier: 2
    requiredMana: 200
    minimumSeconds: 0.35
  - stepId: skill1_followup
    objectiveText: '차단으로 열린 틈을 Skill1으로 확인해라.'
    promptText: 'S1이 막은 뒤에만 Skill1 확인. 무작정 사격으로 밀지 않는다.'
    focusAction: 120
    dimUnfocusedActions: 1
    completionCondition: 72
    requiredTier: 1
    requiredMana: 0
    minimumSeconds: 0.35
  - stepId: pocket_result
    objectiveText: '생존 기록을 확인해라.'
    promptText: '성공/실패는 버튼 넘김이 아니라 HP, 차단, 확인 기록으로 정해진다.'
    focusAction: 0
    dimUnfocusedActions: 0
    completionCondition: 90
    requiredTier: 1
    requiredMana: 0
    minimumSeconds: 0.1
