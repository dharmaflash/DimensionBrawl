  m_Name: 
  m_EditorClassIdentifier: DimensionBrawl.Runtime::DimensionBrawl.Combat.BossPressureActionDirector
  costLadder: {fileID: 656499983}
  bossBarrageEmitter: {fileID: 656499978}
  summonPressureAction: {fileID: 656499982}
  laneSpace: {fileID: 1051595597}
  trackedPlayer: {fileID: 4001}
  actionDeckProfile: {fileID: 11400000, guid: d3bfab58be344471b4b4b2f953ae6f10, type: 2}
  actionSlots:
  - Pattern: {fileID: 11400000, guid: 25cd6927b39e10048ab562c4e150cb3a, type: 2}
    ActionKind: 0
    MinimumTier: 1
    QueuedWaves: 1
    MinimumIntervalSeconds: 4.2
    ResponseId: DodgeLineOrUseSkill1
    StageLoopRole: LV1 skill pressure that asks the player to read a committed rail
      before spending summon resources.
    PlayerAnswer: Strafe or dodge out of the rail, then use ranged fire or Skill1
      when the lane is clear.
    SummonAnswer: No summon is required; save SummonSlot1 for screen pressure.
    UsePlayerForwardRiskGate: 0
    MinimumPlayerForwardRisk01: 0
    MaximumPlayerForwardRisk01: 1
    UsePlayerSummonResponseGate: 0
    MinimumPlayerSummonTier: 1
  - Pattern: {fileID: 11400000, guid: 732ffa1eae726f14386a4a02115611c9, type: 2}
    ActionKind: 1
    MinimumTier: 1
    QueuedWaves: 1
    MinimumIntervalSeconds: 3.8
    ResponseId: EscortProbeFrontlineCheck
    StageLoopRole: LV1 escort-probe summon pressure that lets the boss contest the
      frontline before the player reaches a full support stack.
    PlayerAnswer: Use ranged fire or a cheap summon answer before the probe turns
      the lane into a screen trade.
    SummonAnswer: A low-tier summon can body-clash or absorb the probe without waiting
      for a perfect LV2 answer.
    UsePlayerForwardRiskGate: 0
    MinimumPlayerForwardRisk01: 0
    MaximumPlayerForwardRisk01: 1
    UsePlayerSummonResponseGate: 0
    MinimumPlayerSummonTier: 1
  - Pattern: {fileID: 11400000, guid: 732ffa1eae726f14386a4a02115611c9, type: 2}
    ActionKind: 1
    MinimumTier: 2
    QueuedWaves: 1
    MinimumIntervalSeconds: 4.2
    ResponseId: SummonSlot1PressureBlock
    StageLoopRole: LV2 summon-pressure exchange that answers the player's heavy SUMMON
      with an immediate boss-side body screen.
    PlayerAnswer: Spend SUMMON deliberately; expect the boss to answer with a visible
      pressure body before the punish window opens.
    SummonAnswer: The player summon should clash with the boss screen, break the
      curtain, and reopen ranged punish time.
    UsePlayerForwardRiskGate: 0
    MinimumPlayerForwardRisk01: 0
    MaximumPlayerForwardRisk01: 1
    UsePlayerSummonResponseGate: 1
    MinimumPlayerSummonTier: 2
  - Pattern: {fileID: 11400000, guid: b0b5e71e44209f74394f56e232db8d78, type: 2}
    ActionKind: 2
    MinimumTier: 3
    QueuedWaves: 1
    MinimumIntervalSeconds: 6
    ResponseId: RetreatOrSpendHighTierAnswer
    StageLoopRole: LV3 overextend punish that closes gaps when the player stays near
      the forward boundary too long.
    PlayerAnswer: Retreat from forward-risk space or dodge through the shrinking
      net before firing back.
    SummonAnswer: A prepared high-tier summon screen can buy the follow-up window,
      but it should cost the player's stored EN.
    UsePlayerForwardRiskGate: 1
    MinimumPlayerForwardRisk01: 0.66
    MaximumPlayerForwardRisk01: 1
    UsePlayerSummonResponseGate: 0
    MinimumPlayerSummonTier: 1
  globalRecoverySeconds: 1.1
  holdForNextTierActionWhenGateAllows: 1
  actionsEnabled: 1
  playerSummonResponseWindowSeconds: 4
  heldResponseWindowFloorSeconds: 0.6
  maxHeldResponseWindowExtensionSeconds: 1.5
